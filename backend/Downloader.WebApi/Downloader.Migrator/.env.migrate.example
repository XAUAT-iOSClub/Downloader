# Downloader 存储迁移配置（R2 -> COS）
#
# 复制本文件为 .env.migrate 后填写真实值。.env.migrate 已被 .gitignore 忽略。
# 所有变量也可以直接用同名环境变量提供；环境变量优先于文件。

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------
# PostgreSQL（生产）示例：
SQL=Host=127.0.0.1;Port=5432;Username=postgres;Database=downloader;Password=change-me
# SQLite（本地）示例：
# SQL=Data Source=downloader.db
#
# 也可以不写，自动从连接串判断；可选 auto / postgres / sqlite：
MIGRATION__DB_PROVIDER=auto

# ---------------------------------------------------------------------------
# 源存储：Cloudflare R2
# ---------------------------------------------------------------------------
SOURCE__ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
SOURCE__BUCKET=app
SOURCE__REGION=auto
SOURCE__ACCESS_KEY=<R2_ACCESS_KEY_ID>
SOURCE__SECRET_KEY=<R2_SECRET_ACCESS_KEY>
SOURCE__KEY_PREFIX=downloader
SOURCE__FORCE_PATH_STYLE=true
SOURCE__DISABLE_CHECKSUM=true

# ---------------------------------------------------------------------------
# 目标存储：腾讯云 COS
# ---------------------------------------------------------------------------
# 也可以只填 TARGET__REGION，让工具推导 https://cos.<region>.myqcloud.com
TARGET__ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
TARGET__BUCKET=<BUCKET_NAME>-<APPID>
TARGET__REGION=ap-guangzhou
TARGET__ACCESS_KEY=<COS_SECRET_ID>
TARGET__SECRET_KEY=<COS_SECRET_KEY>
# 走 API 代理 /files 时，目标 KeyPrefix 必须与源一致，数据库 URL 才不会变化。
TARGET__KEY_PREFIX=downloader
TARGET__FORCE_PATH_STYLE=false
# COS 对 AWS SDK v4 默认的 CRC 校验头支持不稳定，保持 true 更稳妥。
TARGET__DISABLE_CHECKSUM=true

# ---------------------------------------------------------------------------
# 数据库里保存的公开 URL
# ---------------------------------------------------------------------------
# 当前应用把 Storage__PublicBaseUrl + /files 拼成公开 URL。
MIGRATION__OLD_PUBLIC_BASE=https://appapi.xauat.site/files
# 继续走 API 代理时保持与旧值一致；如果改用 COS 自定义域名，改这里。
MIGRATION__NEW_PUBLIC_BASE=https://appapi.xauat.site/files
# 可选：额外的“已迁移”前缀，用于识别已经指向目标存储的旧记录，分号分隔。
# MIGRATION__TARGET_PUBLIC_BASE=https://cdn.example.com

# ---------------------------------------------------------------------------
# 迁移行为
# ---------------------------------------------------------------------------
# 并发对象数，1-32
MIGRATION__CONCURRENCY=4
# 校验方式：size（默认）/ sha256 / none
MIGRATION__VERIFY=size
# 是否更新数据库；也可以运行时用 --no-db 关闭
MIGRATION__UPDATE_DATABASE=true
# 是否删除 R2 源对象；建议先保持 false。删除会在数据库更新成功后执行
MIGRATION__DELETE_SOURCE=false
# 大文件分片大小（MB），5-512
MIGRATION__PART_SIZE_MB=16
# 小于该阈值的对象一次性读入内存上传（MB），1-512
MIGRATION__SMALL_OBJECT_MB=8
# 断点/审计文件、CSV 报告、日志，相对路径以配置文件所在目录为基准
MIGRATION__STATE_FILE=migration-state.json
MIGRATION__REPORT_FILE=migration-report.csv
MIGRATION__LOG_FILE=migration.log
