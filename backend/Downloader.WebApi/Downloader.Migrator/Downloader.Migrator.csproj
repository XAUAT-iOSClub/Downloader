<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AssemblyName>Downloader.Migrator</AssemblyName>
        <RootNamespace>Downloader.Migrator</RootNamespace>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AWSSDK.S3" Version="4.0.22.2" />
        <PackageReference Include="DotNetEnv" Version="3.1.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Downloader.Data\Downloader.Data.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include=".env.migrate.example" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
