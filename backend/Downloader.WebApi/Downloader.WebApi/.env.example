# 宿主机映射端口，仅供部署目录的 docker-compose.production.yml 插值使用；
# 应用容器内始终监听 8080。默认 8081（同机 XAUAT.EduApi 占用 8080）。
# 在服务器 .env 里改这里即可；CI 的仓库/环境 Variables 里设置 APP_PORT 也可覆盖。
# APP_PORT=8081

SQL=Host=127.0.0.1;Port=5432;Username=postgres;Database=downloader;Password=your-password
# ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Username=postgres;Database=downloader;Password=your-password

JwtSettings__SecretKey=ThisIsAVerySecretKeyForJwtTokenGeneration
JwtSettings__Issuer=DownloaderApp
JwtSettings__Audience=DownloaderUsers
JwtSettings__ExpireDays=7

Storage__Provider=Local
Storage__PublicBaseUrl=http://localhost:5046
# Storage__S3__Bucket=your-bucket-1250000000
# Storage__S3__Region=ap-guangzhou
# Storage__S3__ServiceUrl=https://cos.ap-guangzhou.myqcloud.com
# Storage__S3__PublicBaseUrl=https://download.example.com
# Storage__S3__AccessKey=AKIDxxxxxxxxxxxxxxxx
# Storage__S3__SecretKey=xxxxxxxxxxxxxxxxxxxx
# Storage__S3__KeyPrefix=downloader
# Storage__S3__ForcePathStyle=false
# 腾讯云 COS 建议显式关闭 AWS SDK v4 默认 CRC 校验头：
# Storage__S3__DisableChecksum=true
# 如遇签名/分块上传问题可再尝试：
# Storage__S3__DisablePayloadSigning=true
#
# Cloudflare R2 example
# Storage__Provider=R2
# Storage__S3__Bucket=your-r2-bucket
# Storage__S3__Region=auto
# Storage__S3__ServiceUrl=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Storage__S3__PublicBaseUrl=https://download.example.com
# Storage__S3__AccessKey=<R2_ACCESS_KEY_ID>
# Storage__S3__SecretKey=<R2_SECRET_ACCESS_KEY>
# Storage__S3__KeyPrefix=downloader
# Storage__S3__ForcePathStyle=true

# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxx
# Storage__Provider=VercelBlob
# Storage__VercelBlob__Access=public
# Storage__VercelBlob__AddRandomSuffix=false
# Storage__VercelBlob__AllowOverwrite=false
# Storage__VercelBlob__CacheControlMaxAge=31536000
